# Public site URL (used for SEO metadata + sitemap)
NEXT_PUBLIC_SITE_URL=https://45one.co.za

# --- YouTube ---------------------------------------------------------------
# Channel ID is already hardcoded (UCJF9nMe1hKT22XskyCdlinA) — override here
# if it ever changes. The video list works with no key at all (public RSS).
YOUTUBE_CHANNEL_ID=UCJF9nMe1hKT22XskyCdlinA

# Add a YouTube Data API v3 key to unlock LIVE numbers:
#   - total channel views
#   - per-video view + like counts
# Free: console.cloud.google.com -> new project -> enable "YouTube Data API v3"
#       -> Credentials -> Create API key. Daily quota is far more than needed.
YOUTUBE_API_KEY=

# --- Instagram live follower count -----------------------------------------
# NOT REQUIRED — the follower count already reads live from the public profile.
# These are an optional, more durable fallback: a Business/Creator account plus
# a long-lived Instagram Graph API token from developers.facebook.com.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# --- TikTok live follower count --------------------------------------------
# NOT REQUIRED — followers and likes already read live from the public profile.
# Optional durable fallback: a TikTok for Developers app with the Display API
# scopes (user.info.profile + user.info.stats) authorised by @45one_za_.
TIKTOK_ACCESS_TOKEN=

# --- Contact form delivery (optional) --------------------------------------
# Without these, submissions are logged to the server console.
RESEND_API_KEY=
RESEND_FROM="45one site <hello@45one.co.za>"
CONTACT_TO=partnerships@45one.co.za
